          "name": "P-01 Create a valid pet",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 200\", function(){\r\n    pm.response.to.have.status(200);\r\n});\r\n\r\npm.test(\"Response contais the created pet name\", function(){\r\n    const pet = pm.response.json();\r\n    pm.expect(pet.name).to.eql(\"Bruno\");\r\n});\r\n"
                ]
              }
            },
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set(\"petId\", _.random(1000000, 999999999));"
                ]
              }
            }
          ],
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "{\r\n  \"id\": {{petId}},\r\n  \"category\": { \"id\": 1, \"name\": \"dogs\" },\r\n  \"name\": \"Bruno\",\r\n  \"photoUrls\": [\"https://example.com/bruno.jpg\"],\r\n  \"status\": \"available\"\r\n}",
